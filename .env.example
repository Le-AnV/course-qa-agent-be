# Copy to .env and fill in real values. Never commit real keys.

# Postgres (docker-compose)
DATABASE_URL=postgresql+psycopg://qa:qa@localhost:5432/course_qa
# Qdrant (docker-compose)
QDRANT_URL=http://localhost:6333
# Backend
APP_ENV=local
# Application log level (DEBUG, INFO, WARNING, ERROR). INFO shows the per-turn
# gate/rewrite latency lines used to track AI-63.
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000","http://localhost:3100","http://127.0.0.1:3000","http://127.0.0.1:3100"]
# Local source files; Docker Compose overrides this to /app/storage/documents
DOCUMENT_STORAGE_DIR=./storage/documents
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# Per-member keys, one per developer via env (T34/E8) - never commit real values
GEMINI_API_KEY=
# Stable secret used to encrypt admin-managed Gemini keys at rest.
# Falls back to JWT_SECRET in local dev; set a dedicated value in production.
GEMINI_KEY_ENCRYPTION_KEY=
TAVILY_API_KEY=
# OpenAI Decisions scope-gate fallback. Prefer adding keys via Admin > Settings >
# OpenAI key pool (Decisions); this value is used only when no pool key is healthy.
OPENAI_API_KEY=
SERPAPI_API_KEY=
# Class scope decision (AI-61). Gemini is the default and reuses GEMINI_API_KEY.
# Set DECISION_PROVIDER=openai (or openai_compatible) to use any endpoint that
# implements /chat/completions and supports JSON schemas: OpenAI, Groq,
# OpenRouter, Ollama, vLLM... Then fill DECISION_BASE_URL and OPENAI_API_KEY.
# Without a usable provider the gate fails open and every question continues
# through the RAG flow.
DECISION_PROVIDER=gemini
DECISION_MODEL=models/gemini-3.1-flash-lite
DECISION_BASE_URL=https://api.openai.com/v1
# A verdict blocks the turn only when it is out_of_scope at or above this value.
DECISION_CONFIDENCE_THRESHOLD=0.8
# Total budget for one gate decision. When the fallback is enabled, part of this
# budget is reserved for the fallback model so a primary timeout does not use it
# all up.
DECISION_TIMEOUT_SECONDS=12
DECISION_CONNECT_TIMEOUT_SECONDS=3
DECISION_MAX_OUTPUT_TOKENS=200
# Transient Gemini 503/504 errors used to fail the gate open. The fallback model
# is tried within the same budget, and a failing primary is skipped for the
# cooldown so later turns go straight to the fallback. For a non-Gemini
# provider, point DECISION_FALLBACK_MODEL at a model that endpoint serves, or
# set DECISION_FALLBACK_ENABLED=false.
DECISION_FALLBACK_ENABLED=true
DECISION_FALLBACK_MODEL=models/gemini-flash-lite-latest
DECISION_FALLBACK_TIMEOUT_SECONDS=6
DECISION_COOLDOWN_SECONDS=60
# Keys come from the admin pools first (Admin > Settings > Gemini / OpenAI keys),
# then from GEMINI_API_KEY / OPENAI_API_KEY. This bounds how many pool keys one
# attempt may try before the fallback model is used.
DECISION_KEY_ATTEMPTS=3
# Internet search (T19). FETCH is what Google is asked for, MAX is what survives
# reputation filtering and gets cited.
SERPAPI_FETCH_RESULTS=10
SERPAPI_MAX_RESULTS=5
SERPAPI_TIMEOUT_SECONDS=10

# --- Auth (E1 / AI-25, AI-27, AI-31) ---
JWT_SECRET=dev-only-secret-change-me-use-env-in-prod
JWT_EXPIRE_MINUTES=720
# Bootstrap admin created on first login when no admin exists yet.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=Admin123!

# --- Email sender (E8 / AI-105, AC-08) ---
# Gmail / Google Workspace APP password — never a personal password, never hardcoded.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Canonical sender key; SMTP_SENDER is accepted as a legacy alias.
SMTP_SENDER_EMAIL=
SMTP_SENDER=
SMTP_APP_PASSWORD=
SMTP_RATE_PER_MINUTE=20
# true = record in outbox without real SMTP (local dev / tests).
EMAIL_DRY_RUN=true

# --- Contextual follow-up questions (AI-63) ---
# Number of previous Q&A exchanges sent to the model, and their character budget.
CHAT_CONTEXT_EXCHANGES=5
CHAT_CONTEXT_MAX_CHARS=6000
# Follow-up rewriting gets its own budget: a timed-out rewrite degrades a web
# search into a bare fragment.
CHAT_CONDENSE_TIMEOUT_SECONDS=10
# Lite Gemini model used when the primary helper model errors during rewriting.
CHAT_FALLBACK_MODEL=models/gemini-flash-lite-latest
# Character budget for the history block given to the class scope gate.
CHAT_SCOPE_HISTORY_MAX_CHARS=2000
# Hard cap on a rewritten standalone question.
CHAT_REWRITE_MAX_CHARS=1200
# When the rewrite model fails, the class name/description anchors the search
# query instead of sending a bare follow-up fragment.
CHAT_CLASS_CONTEXT_MAX_CHARS=240
# The class gate and follow-up rewrite run in parallel under this one deadline.
CHAT_PRE_RETRIEVAL_TIMEOUT_SECONDS=15
# Whole-turn budget: from the first streamed token to the done event.
CHAT_TIMEOUT_SECONDS=300
